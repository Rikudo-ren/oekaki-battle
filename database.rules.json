{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() == auth.uid && newData.child('phase').val() == 'lobby') || (data.exists() && data.child('host').val() == auth.uid))",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($room).child('phase').val() == 'lobby' && ((!data.exists() && newData.hasChildren(['name', 'score']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 12 && newData.child('score').val() == 0) || (data.exists() && !newData.exists()))"
          }
        }
      }
    },
    "secrets": {
      "$room": {
        "$game": {
          "$turn": {
            ".read": "auth != null && root.child('rooms').child($room).child('gameId').val() == $game && root.child('rooms').child($room).child('phase').val() == 'playing' && root.child('rooms').child($room).child('drawer').val() == auth.uid && root.child('rooms').child($room).child('turn').val() + '' == $turn",
            ".write": "auth != null && root.child('rooms').child($room).child('gameId').val() == $game && root.child('rooms').child($room).child('host').val() == auth.uid && root.child('rooms').child($room).child('phase').val() == 'starting'",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          }
        }
      }
    },
    "claims": {
      "$room": {
        "$game": {
          ".read": "auth != null && root.child('rooms').child($room).child('gameId').val() == $game && root.child('rooms').child($room).child('players').child(auth.uid).exists()",
          "$turn": {
            ".write": "auth != null && !data.exists() && root.child('rooms').child($room).child('gameId').val() == $game && root.child('rooms').child($room).child('phase').val() == 'playing' && root.child('rooms').child($room).child('turn').val() + '' == $turn && root.child('rooms').child($room).child('drawer').val() != auth.uid && root.child('rooms').child($room).child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['uid', 'answer']) && newData.child('uid').val() == auth.uid && newData.child('answer').isString() && newData.child('answer').val() == root.child('secrets').child($room).child($game).child($turn).val()"
          }
        }
      }
    },
    "drawings": {
      "$room": {
        "$game": {
          "$turn": {
            ".read": "auth != null && root.child('rooms').child($room).child('gameId').val() == $game && root.child('rooms').child($room).child('players').child(auth.uid).exists()",
            "$stroke": {
              ".write": "auth != null && root.child('rooms').child($room).child('gameId').val() == $game && root.child('rooms').child($room).child('phase').val() == 'playing' && root.child('rooms').child($room).child('drawer').val() == auth.uid && root.child('rooms').child($room).child('turn').val() + '' == $turn && !root.child('claims').child($room).child($game).child($turn).exists() && !data.exists()",
              ".validate": "newData.hasChildren(['color', 'width', 'points']) && newData.child('points').isString() && newData.child('points').val().length <= 16000 && newData.child('color').isString() && newData.child('width').isNumber() && newData.child('width').val() >= 1 && newData.child('width').val() <= 30"
            }
          }
        }
      }
    }
  }
}
