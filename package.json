{
  "name": "oekaki-battle",
  "private": true,
  "scripts": {
    "build": "node scripts/firebase-config.cjs && esbuild src/app.js --bundle --minify --outfile=public/app.js",
    "test": "node --test tests/*.test.cjs",
    "test:rules": "npx --yes firebase-tools emulators:exec --only database --project demo-oekaki \"node --test tests/rules-emulator.cjs\""
  },
  "dependencies": {
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3"
  }
}
